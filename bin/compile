#!/usr/bin/env bash

# Some changes pulled from
# tephe/heroku-buildpack-ci-elasticsearch, and likely other forks from
# doctolib/heroku-buildpack-ci-elasticsearch

set -e

BUILD_DIR=$1
CACHE_DIR=$2
ENV_DIR=$3

indent() {
  sed -u 's/^/       /'
}

VERSION=${ELASTICSEARCH_VERSION-"7.17.7"}
ARCH=${ELASTICSEARCH_ARCH-"linux-x86_64"}

INSTALL_DIR="$BUILD_DIR/.heroku/vendor/elasticsearch"
PROFILE_PATH="$BUILD_DIR/.profile.d/elasticsearch.sh"

mkdir -p $INSTALL_DIR
mkdir -p $(dirname $PROFILE_PATH)
mkdir -p $CACHE_DIR

echo "Search in cache directory $CACHE_DIR/elasticsearch-$VERSION" | indent

if [ ! -d $CACHE_DIR/elasticsearch-$VERSION ]; then
  echo "Fetching and installing Elasticsearch 7+" | indent
  cd $CACHE_DIR
  curl -sOL "https://artifacts.elastic.co/downloads/elasticsearch/elasticsearch-$VERSION-$ARCH.tar.gz"
  tar zxf "elasticsearch-$VERSION-$ARCH.tar.gz"
  cd "elasticsearch-$VERSION"
  cp -r $CACHE_DIR/elasticsearch-$VERSION/* $INSTALL_DIR/
else
  echo "Installing elasticsearch from cache" | indent
  cp -r $CACHE_DIR/elasticsearch-$VERSION/* $INSTALL_DIR/
fi

cat <<EOF >> $PROFILE_PATH
export PATH=/app/.heroku/vendor/elasticsearch/bin:\$PATH
export ELASTICSEARCH_URL=http://localhost:9200
export ES_JAVA_OPTS="-Xmx12g -Dfile.encoding=UTF-8"

if [ ! -f /tmp/es.pid ]; then
  echo "# Starting ElasticSearch..."
  elasticsearch -E xpack.security.enabled=false -d -p /tmp/es.pid

  echo "# Waiting for Elasticsearch cluster to go to green..."
  curl -o /dev/null --retry-delay 3 --retry 200 --retry-connrefuse --max-time 60 -s "http://localhost:9200/_cluster/health?wait_for_status=green&timeout=50s"
fi
EOF
